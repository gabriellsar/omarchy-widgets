# gabriellsar-widgets — segredos locais. NUNCA vai para o git.
# `gw init` copia para ~/.config/gabriellsar-widgets/secrets.env com chmod 600.
# Formato KEY=VALUE, sem aspas. Linhas vazias ficam ignoradas.

# Quantfury MCP — o nome tem que bater com invest.mcp.secret_env / headers.
QUANTFURY_API_KEY=

# brapi.dev (só se invest.market.provider = "brapi")
BRAPI_TOKEN=

# Spotify Web API (só se spotify.use_web_api = true)
# App em https://developer.spotify.com/dashboard com redirect URI http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
# Preenchido sozinho por `gw spotify auth`:
SPOTIFY_REFRESH_TOKEN=
